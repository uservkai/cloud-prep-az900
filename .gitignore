# ==========================================
# CloudPrep AZ-900 — Git Ignore
# ==========================================

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules/

# ==========================================
# Build outputs
# ==========================================
dist/
dist-ssr/
.output/
.vercel/
.vinxi/
.tanstack/
.nitro/
.vite/

# ==========================================
# Cloudflare / Wrangler
# ==========================================
.wrangler/
.dev.vars
.dev.vars.*

# ==========================================
# Environment variables
# ==========================================
.env
.env.*
*.local

# Allow safe environment examples
!.env.example
!.env.sample
!.env.template

# ==========================================
# Testing and coverage
# ==========================================
coverage/
.nyc_output/
test-results/
playwright-report/
*.tsbuildinfo

# ==========================================
# Cache and temporary files
# ==========================================
.cache/
.turbo/
*.tmp
*.temp
*.bak
*.orig

# ==========================================
# Editor directories and files
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
*.iml

# ==========================================
# Operating system files
# ==========================================
.DS_Store
Thumbs.db
Desktop.ini

# ==========================================
# Windows / Visual Studio
# ==========================================
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
